@CRM.api_HostAddress = http://localhost:5299

### ==================== PHASE 1: DATA COLLECTION ====================

### 1. Create SUPERADMIN role
POST {{CRM.api_HostAddress}}/roles
Content-Type: application/json

{
  "roleCode": "SUPERADMIN",
  "roleName": "Super Administrator",
  "description": "Full access",
  "isActive": true
}

### 2. Create ADMIN role
POST {{CRM.api_HostAddress}}/roles
Content-Type: application/json

{
  "roleCode": "ADMIN",
  "roleName": "Administrator",
  "description": "Business administration",
  "isActive": true
}

### 3. Create MANAGER role
POST {{CRM.api_HostAddress}}/roles
Content-Type: application/json

{
  "roleCode": "MANAGER",
  "roleName": "Manager",
  "description": "Operations manager",
  "isActive": true
}

### 4. Create STAFF role
POST {{CRM.api_HostAddress}}/roles
Content-Type: application/json

{
  "roleCode": "STAFF",
  "roleName": "Staff",
  "description": "Cashier / crew",
  "isActive": true
}

### 5. List Roles
GET {{CRM.api_HostAddress}}/roles
Accept: application/json

### 6. Register superadmin
POST {{CRM.api_HostAddress}}/auth/register
